par(mfrow = c(1, 3), oma = c(0, 0, 3, 0)) #mfrow is the function we use to plot the three graphs; oma is the opacity 
plot(gci_data$legal * 5, gci_data$technical *5,
     main = "Legal vs. Technical",
     xlab = "Legal score (rescaled 0–100)", ylab = "Technical score (rescaled 0–100)",
     pch = 19, col = "#C15F3C80")

plot(gci_data$capacity * 5, gci_data$technical * 5,
     main = "Capacity vs. Technical",
     xlab = "Capacity score (rescaled 0–100)", ylab = "Technical score (rescaled 0–100)",
     pch = 19, col = "#C15F3C80")

